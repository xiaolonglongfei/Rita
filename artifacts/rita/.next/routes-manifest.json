{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/instructors/[id]",
      "regex": "^/api/instructors/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/instructors/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/moderation/[id]",
      "regex": "^/api/moderation/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/moderation/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/reviews/[id]/verify",
      "regex": "^/api/reviews/([^/]+?)/verify(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/reviews/(?<nxtPid>[^/]+?)/verify(?:/)?$"
    },
    {
      "page": "/instructors/[id]",
      "regex": "^/instructors/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/instructors/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/admin/instructors",
      "regex": "^/admin/instructors(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/instructors(?:/)?$"
    },
    {
      "page": "/admin/moderation",
      "regex": "^/admin/moderation(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/moderation(?:/)?$"
    },
    {
      "page": "/admin/users",
      "regex": "^/admin/users(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/users(?:/)?$"
    },
    {
      "page": "/instructors",
      "regex": "^/instructors(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/instructors(?:/)?$"
    },
    {
      "page": "/instructors/new",
      "regex": "^/instructors/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/instructors/new(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/profile",
      "regex": "^/profile(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/profile(?:/)?$"
    },
    {
      "page": "/ranking",
      "regex": "^/ranking(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ranking(?:/)?$"
    },
    {
      "page": "/reviews/new",
      "regex": "^/reviews/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/reviews/new(?:/)?$"
    },
    {
      "page": "/sessions",
      "regex": "^/sessions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sessions(?:/)?$"
    },
    {
      "page": "/signup",
      "regex": "^/signup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/signup(?:/)?$"
    },
    {
      "page": "/test-auth",
      "regex": "^/test\\-auth(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/test\\-auth(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}